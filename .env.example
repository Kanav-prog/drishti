# ==============================================================================
# DRISHTI Deployment Environment Configuration (.env.example)
# Copy this file to .env and configure values for local or production use.
# Safe placeholders only - Never commit real credentials.
# ==============================================================================

# ── Application Environment ───────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
PYTHONIOENCODING=utf-8

# ── Port & Host Binding (Injected automatically by Render as $PORT) ───────────
PORT=8000
UVICORN_WORKERS=1

# ── Database Configuration ───────────────────────────────────────────────────
# Default: SQLite file within container
DATABASE_URL=sqlite:///./drishti.db
# For Render Managed PostgreSQL:
# DATABASE_URL=postgresql://username:password@hostname.render.com:5432/dbname

# ── Streaming & Telemetry Ingestion ───────────────────────────────────────────
# Options: 'mock' (Recommended for standalone / Render Free tier), 'redis', 'kafka'
STREAMING_BACKEND=mock
SIMULATION_TICK_SECONDS=5

# ── Redis Cache (Optional - Used only if STREAMING_BACKEND=redis) ─────────────
# REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate a strong 32+ character secret for production token signing
JWT_SECRET=replace-with-a-secure-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# ── AI / ML Engine Parameters ─────────────────────────────────────────────────
CASCADE_DECAY_RATE=0.15
SIGNATURE_MATCH_THRESHOLD=40
BATCH_SIZE=100
BATCH_TIMEOUT=60
MAX_WORKERS=4

# ── External Notifications (Optional) ────────────────────────────────────────
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_FROM_NUMBER=your_twilio_number
# SENDGRID_API_KEY=your_sendgrid_key
