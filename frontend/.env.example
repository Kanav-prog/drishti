# DRISHTI Frontend Environment Configuration
# Copy to .env.local for custom local settings.

# Backend API URL (Points to Render in production)
VITE_API_URL=https://drishti-api.onrender.com

# Backend WebSocket URL (Direct connection to Render since Vercel does not proxy WebSockets)
VITE_WS_URL=wss://drishti-api.onrender.com/ws
